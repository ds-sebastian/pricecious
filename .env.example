# Required. postgresql:// URLs are used with the asyncpg driver automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/pricewatch

# Browserless (or any Chrome with remote debugging).
BROWSERLESS_URL=ws://browserless:3000
# BROWSERLESS_TOKEN=
# BROWSERLESS_BLOCK_ADS=true
# BROWSERLESS_STEALTH=true
# BROWSERLESS_HEADLESS=new
# BROWSERLESS_VIEWPORT_WIDTH=1920
# BROWSERLESS_VIEWPORT_HEIGHT=1080

# Optional
# SCREENSHOT_DIR=screenshots
# CORS_ORIGINS=https://pricecious.example.com
# LOG_LEVEL=INFO
# SQL_ECHO=false

# AI, scraper and schedule settings live in the Settings page, not here.
